# Copy to .env on the deploy host (docker-compose.prod.yml reads it via
# `env_file: .env` on every service) and fill in real values — nothing here
# is safe to run as-is. Unlike .env.example (dev), this targets managed/real
# infra: a real Postgres, real Redis, Cloudflare R2 instead of MinIO, a real
# SMTP provider, and live Paymob credentials.

# Single-origin deploy: one domain for everything, `web`'s own Nginx
# terminates TLS and reverse-proxies /api/v1 + /socket.io to `api`
# internally (docker/nginx/web.conf) — the browser never talks to `api`
# directly, so no CORS/cross-origin config needed. Replace with your real
# domain (must already point at this VPS — see README's Deployment section).
DOMAIN=foryou2.online
# openssl rand -base64 48's worth of care isn't needed here, but a real
# inbox you check is — used for Let's Encrypt renewal/expiry notices, and
# only by scripts/init-letsencrypt.sh (not read by any running service).
CERTBOT_EMAIL=aabdullah.zayed0099@gmail.com

NODE_ENV=production
PORT=4000
APP_URL=https://foryou2.online
WEB_URL=https://foryou2.online

# Same-origin deploy (docker/nginx/web.conf proxies /api/v1 to the api
# service) — leave this relative unless you deliberately split web/api
# across two origins instead (would also need CORS_EXTRA_ORIGINS below and
# apps/api's `allowedOrigins`, src/config/env.ts, revisited).
VITE_API_URL=/api/v1

# If using the bundled postgres/redis services in docker-compose.prod.yml,
# host must be the service name, not localhost.
POSTGRES_USER=foryou
POSTGRES_PASSWORD=change-me-generate-a-real-secret
POSTGRES_DB=foryou
DATABASE_URL=postgres://foryou:change-me-generate-a-real-secret@postgres:5432/foryou

REDIS_URL=redis://redis:6379

# openssl rand -base64 48 — generate distinct real secrets for each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FOR YOU <no-reply@foryou.example>"

# Cloudflare R2 (S3-compatible) — see architecture doc §12.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=foryou
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=https://pub-871d979496884508b01262c03d6dc8e3.r2.dev

PAYMOB_MODE=live
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# Optional — error tracking (architecture doc §13). Leave unset to disable.
SENTRY_DSN=
