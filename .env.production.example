# Copy to .env on the deploy host (docker-compose.prod.yml reads it via
# `env_file: .env` on every service) and fill in real values — nothing here
# is safe to run as-is. Unlike .env.example (dev), this targets managed/real
# infra: a real Postgres, real Redis, Cloudflare R2 instead of MinIO, a real
# SMTP provider, and live Paymob credentials.

NODE_ENV=production
PORT=4000
APP_URL=https://api.foryou.citymarket.tech
WEB_URL=https://foryou.citymarket.tech

# Split-subdomain deploy: the browser talks to the api container's own
# subdomain directly (see docker/nginx/vps/), not through the web container,
# so this must be an absolute cross-origin URL, not a relative path. CORS for
# it is handled by WEB_URL above (apps/api's `allowedOrigins`, src/config/env.ts).
VITE_API_URL=https://api.foryou.citymarket.tech/api/v1

# If using the bundled postgres/redis services in docker-compose.prod.yml,
# host must be the service name, not localhost.
POSTGRES_USER=foryou
POSTGRES_PASSWORD=change-me-generate-a-real-secret
POSTGRES_DB=foryou
DATABASE_URL=postgres://foryou:change-me-generate-a-real-secret@postgres:5432/foryou

REDIS_URL=redis://redis:6379

# openssl rand -base64 48 — generate distinct real secrets for each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FOR YOU <no-reply@foryou.example>"

# Cloudflare R2 (S3-compatible) — see architecture doc §12.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=foryou
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=https://pub-871d979496884508b01262c03d6dc8e3.r2.dev

PAYMOB_MODE=live
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# Optional — error tracking (architecture doc §13). Leave unset to disable.
SENTRY_DSN=

# docker-compose.prod.yml binds both of these to 127.0.0.1 only — the host
# Nginx on the VPS (docker/nginx/vps/) owns the public port 80/443 and
# reverse-proxies foryou.citymarket.tech / api.foryou.citymarket.tech to
# these loopback ports by hostname. Must match the proxy_pass ports in
# docker/nginx/vps/*.conf if changed.
API_PORT=4000
WEB_PORT=8081
