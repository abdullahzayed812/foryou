# Copy to .env on the deploy host (docker-compose.prod.yml reads it via
# `env_file: .env` on every service) and fill in real values — nothing here
# is safe to run as-is. Unlike .env.example (dev), this targets managed/real
# infra: a real Postgres, real Redis, Cloudflare R2 instead of MinIO, a real
# SMTP provider, and live Paymob credentials.

NODE_ENV=production
PORT=4000
APP_URL=https://api.foryou.citymarket.tech
WEB_URL=https://foryou.citymarket.tech

# Split-subdomain deploy: the browser talks to the api container's own
# subdomain directly (through the shared citymarket-nginx gateway, see
# docker-compose.prod.yml's top comment), not through the web container, so
# this must be an absolute cross-origin URL, not a relative path. CORS for
# it is handled by WEB_URL above (apps/api's `allowedOrigins`, src/config/env.ts).
VITE_API_URL=https://api.foryou.citymarket.tech/api/v1

# Hosts are foryou-postgres/foryou-redis, NOT postgres/redis — this VPS also
# runs another Docker Compose project (citymarket) with its own same-named
# services, and api/web sit on both networks (see docker-compose.prod.yml's
# top comment), so the bare names "postgres"/"redis" resolve ambiguously.
POSTGRES_USER=foryou
POSTGRES_PASSWORD=change-me-generate-a-real-secret
POSTGRES_DB=foryou
DATABASE_URL=postgres://foryou:change-me-generate-a-real-secret@foryou-postgres:5432/foryou

REDIS_URL=redis://foryou-redis:6379

# openssl rand -base64 48 — generate distinct real secrets for each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FOR YOU <no-reply@foryou.example>"

# Cloudflare R2 (S3-compatible) — see architecture doc §12.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=foryou
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_BASE_URL=https://pub-871d979496884508b01262c03d6dc8e3.r2.dev

PAYMOB_MODE=live
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=

# Optional — error tracking (architecture doc §13). Leave unset to disable.
SENTRY_DSN=
