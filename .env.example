# Copy to .env (root) — apps/api reads this via dotenv/config. Values below
# match docker-compose.dev.yml exactly, so `npm run dev:infra && npm run dev:api`
# works with zero edits for local development.

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:5173
# Comma-separated extra allowed CORS/socket.io origins beyond WEB_URL — e.g.
# testing from another device on the LAN via its IP. Optional.
# CORS_EXTRA_ORIGINS=http://192.168.0.128:5173

# Read by apps/web (Vite only exposes VITE_-prefixed vars to client code).
# Left unset in dev on purpose — apps/web/src/lib/api-url.ts derives it from
# whatever host the page was loaded through instead, so it works from a LAN
# device without editing this file. Set explicitly only for a real deployment.
# VITE_API_URL=http://localhost:4000/api/v1

DATABASE_URL=postgres://foryou:foryou@localhost:5434/foryou_dev

REDIS_URL=redis://localhost:6380

# openssl rand -base64 48   (generate real random secrets before deploying anywhere)
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-0000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="FOR YOU <no-reply@foryou.local>"

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=foryou-media
S3_ACCESS_KEY_ID=foryou-dev
S3_SECRET_ACCESS_KEY=foryou-dev-secret
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/foryou-media

# "mock" fully simulates Paymob locally — no real account needed for dev/test.
PAYMOB_MODE=mock
PAYMOB_HMAC_SECRET=dev-mock-hmac-secret
